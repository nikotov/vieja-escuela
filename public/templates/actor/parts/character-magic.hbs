<section class="ve-section">
  <h3>
    {{localize "VE.Sheet.spells"}}
    {{#if system.magic}}<span class="ve-counter">{{localize "VE.Stat.podAbbr"}} {{system.pod.value}} / {{system.pod.max}}</span>{{/if}}
    {{#if editable}}<a class="ve-control" data-action="itemCreate" data-type="spell" data-tooltip="{{localize 'VE.Sheet.add'}}"><i class="fas fa-plus"></i></a>{{/if}}
  </h3>
  {{#if system.magic}}
    <div class="ve-bar pod"><div class="fill" style="width: {{podPercent}}%"></div></div>
    <p class="ve-hint">{{localize "VE.Sheet.spellsHint"}}</p>
  {{else}}
    <p class="ve-hint"><i class="fas fa-circle-info"></i> {{localize "VE.Sheet.noMagicHint"}}</p>
  {{/if}}

  {{#each spellLevels}}
    <h4 class="ve-subheading">{{label}}</h4>
    <ol class="item-list ve-rows">
      {{#each spells}}
        <li class="item ve-row" data-item-id="{{item.id}}">
          <img src="{{item.img}}" alt="" />
          <a class="ve-row-name" data-action="itemChat" data-tooltip="{{localize 'VE.Sheet.postToChat'}}">{{item.name}}</a>
          {{#if system.divine}}<span class="ve-tag">{{localize "VE.Spell.divine"}}</span>{{/if}}
          <a class="ve-pill rollable" data-action="castSpell" data-tooltip="{{localize 'VE.Spell.cast'}}"><i class="fas fa-wand-sparkles"></i> {{system.pod}} {{localize "VE.Stat.podAbbr"}}</a>
          <div class="ve-controls">
            <a data-action="itemEdit" data-tooltip="{{localize 'Edit'}}"><i class="fas fa-pen"></i></a>
            {{#if @root.editable}}<a data-action="itemDelete" data-tooltip="{{localize 'Delete'}}"><i class="fas fa-trash"></i></a>{{/if}}
          </div>
        </li>
      {{/each}}
    </ol>
  {{else}}
    <p class="ve-empty">{{localize "VE.Sheet.noSpells"}}</p>
  {{/each}}
</section>
