<section class="load">
  <h3>{{localize "VE.Sheet.load"}} <span class="counter {{#if system.load.overloaded}}warning{{/if}}">{{system.load.value}} / {{system.load.max}}</span></h3>
  <div class="bar {{#if system.load.overloaded}}warning{{/if}}"><div class="fill" style="width: {{loadPercent}}%"></div></div>
  {{#if system.load.overloaded}}<p class="hint warning">{{localize "VE.Sheet.overloaded"}}</p>{{/if}}
</section>

<section class="money">
  <h3>{{localize "VE.Sheet.money"}}</h3>
  <div class="money-row">
    {{#each config.currencies as |currency key|}}
      <label>{{localize currency.abbr}} <input type="number" name="system.money.{{key}}" value="{{lookup @root.system.money key}}" min="0" data-dtype="Number" /></label>
    {{/each}}
  </div>
</section>

<section>
  <h3>{{localize "VE.Sheet.weapons"}}
    {{#if editable}}<a class="header-control" data-action="itemCreate" data-type="weapon"><i class="fas fa-plus"></i></a>{{/if}}
  </h3>
  <ol class="item-list">
    {{#each weapons}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <img src="{{item.img}}" alt="" />
        <a class="name" data-action="itemChat">{{item.name}}</a>
        <span class="tag">{{system.damage}}</span>
        <span class="tag">{{system.load}} <i class="fas fa-weight-hanging"></i></span>
        <div class="item-controls">
          <a data-action="itemEdit"><i class="fas fa-edit"></i></a>
          {{#if @root.editable}}<a data-action="itemDelete"><i class="fas fa-trash"></i></a>{{/if}}
        </div>
      </li>
    {{/each}}
  </ol>
</section>

<section>
  <h3>{{localize "VE.Sheet.armor"}}
    {{#if editable}}<a class="header-control" data-action="itemCreate" data-type="armor"><i class="fas fa-plus"></i></a>{{/if}}
  </h3>
  <ol class="item-list">
    {{#each armors}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <img src="{{item.img}}" alt="" />
        <a class="name" data-action="itemChat">{{item.name}}</a>
        <span class="tag">{{localize "VE.Stat.def"}} {{ve-signed system.def}}</span>
        <a class="toggle {{#if system.equipped}}active{{/if}}" data-action="itemToggleEquipped" data-tooltip="{{localize 'VE.Sheet.equipped'}}"><i class="fas fa-shield-halved"></i></a>
        <div class="item-controls">
          <a data-action="itemEdit"><i class="fas fa-edit"></i></a>
          {{#if @root.editable}}<a data-action="itemDelete"><i class="fas fa-trash"></i></a>{{/if}}
        </div>
      </li>
    {{/each}}
  </ol>
</section>

<section>
  <h3>{{localize "VE.Sheet.gear"}}
    {{#if editable}}<a class="header-control" data-action="itemCreate" data-type="gear"><i class="fas fa-plus"></i></a>{{/if}}
  </h3>
  <ol class="item-list">
    {{#each gear}}
      <li class="item flexrow" data-item-id="{{item.id}}">
        <img src="{{item.img}}" alt="" />
        <a class="name" data-action="itemChat">{{item.name}}</a>
        <span class="quantity">
          <a data-action="itemQuantity" data-delta="-1"><i class="fas fa-minus"></i></a>
          {{system.quantity}}
          <a data-action="itemQuantity" data-delta="1"><i class="fas fa-plus"></i></a>
        </span>
        <span class="tag">{{load}} <i class="fas fa-weight-hanging"></i></span>
        <div class="item-controls">
          <a data-action="itemEdit"><i class="fas fa-edit"></i></a>
          {{#if @root.editable}}<a data-action="itemDelete"><i class="fas fa-trash"></i></a>{{/if}}
        </div>
      </li>
    {{/each}}
  </ol>
</section>
