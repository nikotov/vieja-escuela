<form class="{{cssClass}} ve-sheet" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'Name'}}" /></h1>
      <span class="type-label">{{typeLabel}}</span>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="details">{{localize "VE.Tab.details"}}</a>
    <a class="item" data-tab="description">{{localize "VE.Sheet.description"}}</a>
    <a class="item" data-tab="effects">{{localize "VE.Tab.effects"}}</a>
  </nav>

  <section class="sheet-body">
    <div class="tab details" data-group="primary" data-tab="details">
      {{#if partial}}{{> (lookup @root "partial") @root}}{{/if}}
    </div>
    <div class="tab description" data-group="primary" data-tab="description">
      {{editor enrichedDescription target="system.description" button=true editable=editable engine="prosemirror"}}
    </div>
    <div class="tab effects" data-group="primary" data-tab="effects">
      {{> (lookup @root "effectsEditorTemplate")}}
    </div>
  </section>
</form>
