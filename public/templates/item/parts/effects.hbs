<p class="hint">{{localize "VE.Effect.hint"}}</p>
<ol class="item-list effects">
  {{#each effects}}
    <li class="item flexrow" data-effect-id="{{id}}">
      <img src="{{img}}" alt="" />
      <span class="name">{{name}}</span>
      <a class="toggle {{#unless disabled}}active{{/unless}}" data-action="effectToggle" data-tooltip="{{localize 'VE.Effect.toggle'}}"><i class="fas fa-power-off"></i></a>
      <div class="item-controls">
        <a data-action="effectEdit"><i class="fas fa-edit"></i></a>
        <a data-action="effectDelete"><i class="fas fa-trash"></i></a>
      </div>
    </li>
  {{else}}
    <li class="empty">{{localize "VE.Effect.none"}}</li>
  {{/each}}
</ol>
{{#if editable}}<button type="button" data-action="effectCreate"><i class="fas fa-plus"></i> {{localize "VE.Effect.create"}}</button>{{/if}}
