{
  "name": "vieja-escuela",
  "version": "0.1.0",
  "description": "Sistema de Vieja Escuela: el juego de rol para Foundry VTT v12",
  "private": true,
  "type": "module",
  "license": "OGL-1.0a",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch --mode development",
    "pack": "node scripts/pack.mjs",
    "unpack": "node scripts/pack.mjs --unpack",
    "link": "node scripts/link.mjs",
    "link:example": "node scripts/link.mjs --example",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@foundryvtt/foundryvtt-cli": "^3.0.5",
    "eslint": "^10.12.0",
    "fvtt-types": "npm:@league-of-foundry-developers/foundry-vtt-types@12.331.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
