<section class="furia">
  <h3>Furia</h3>
  <p>Mientras estás enfurecido sumas +1 a ataques, pruebas de habilidad y daño.</p>
  <button type="button" data-action="toggleRage">
    {{#if rage}}<i class="fas fa-face-angry"></i> Calmarse{{else}}<i class="fas fa-fire"></i> ¡Enfurecerse!{{/if}}
  </button>
</section>
